<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="MEIUtil.Views.QuotesPage" x:Name="Page" Title="Orçamentos">
<Grid Padding="20" RowDefinitions="Auto,Auto,*" RowSpacing="14" MaximumWidthRequest="1120" HorizontalOptions="Fill">
<VerticalStackLayout><Label Text="VENDAS" Style="{StaticResource Eyebrow}"/><Label Text="Orçamentos" Style="{StaticResource TitleLabel}"/><Label Text="Propostas organizadas e prontas para compartilhar." Style="{StaticResource Caption}"/></VerticalStackLayout>
<Grid Grid.Row="1" ColumnDefinitions="*,Auto"><Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}"/><Button Grid.Column="1" Text="+ Novo orçamento" Command="{Binding AddCommand}"/></Grid>
<CollectionView Grid.Row="2" ItemsSource="{Binding Items}" SelectionMode="None"><CollectionView.EmptyView><VerticalStackLayout Padding="32" Spacing="6"><Label Text="Nenhum orçamento criado" FontAttributes="Bold" HorizontalTextAlignment="Center"/><Label Text="Crie seu primeiro orçamento para começar." Style="{StaticResource Caption}" HorizontalTextAlignment="Center"/></VerticalStackLayout></CollectionView.EmptyView><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,9"><VerticalStackLayout Spacing="10"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><VerticalStackLayout><Label Text="{Binding Number}" Style="{StaticResource Eyebrow}"/><Label Text="{Binding ClientName}" FontAttributes="Bold"/></VerticalStackLayout><Label Grid.Column="1" Text="{Binding Total, StringFormat='{}{0:C2}'}" FontSize="18" FontAttributes="Bold"/></Grid><Label Text="{Binding Description}" Style="{StaticResource Caption}" MaxLines="3"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><Label Text="{Binding ValidityText}" Style="{StaticResource Caption}" VerticalOptions="Center"/><Button Grid.Column="1" Text="Compartilhar" Style="{StaticResource SecondaryButton}" Command="{Binding Source={x:Reference Page}, Path=BindingContext.ShareCommand}" CommandParameter="{Binding .}"/></Grid></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
</Grid></ContentPage>
