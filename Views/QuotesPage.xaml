<?xml version="1.0" encoding="utf-8" ?><ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="MEIUtil.Views.QuotesPage" x:Name="Page" Title="Orçamentos"><Grid Padding="20" RowDefinitions="Auto,Auto,*" RowSpacing="14" MaximumWidthRequest="1120" HorizontalOptions="Fill"><VerticalStackLayout><Label Text="VENDAS" Style="{StaticResource Eyebrow}"/><Label Text="Orçamentos" Style="{StaticResource TitleLabel}"/></VerticalStackLayout><Grid Grid.Row="1" ColumnDefinitions="*,Auto"><Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}"/><Button Grid.Column="1" Text="+ Novo orçamento" Command="{Binding AddCommand}"/></Grid><CollectionView Grid.Row="2" ItemsSource="{Binding Items}"><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,9"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding Number}" Style="{StaticResource Eyebrow}"/><Label Text="{Binding ClientName}" FontAttributes="Bold"/><Label Text="{Binding Description}" Style="{StaticResource Caption}"/><Label Text="{Binding ValidUntil, StringFormat='Válido até {0:dd/MM/yyyy}'}" Style="{StaticResource Caption}"/></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label Text="{Binding Total, StringFormat='{}{0:C2}'}" FontAttributes="Bold"/><Button Text="Compartilhar" Style="{StaticResource SecondaryButton}" Command="{Binding Source={x:Reference Page}, Path=BindingContext.ShareCommand}" CommandParameter="{Binding .}"/></VerticalStackLayout></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView></Grid></ContentPage>