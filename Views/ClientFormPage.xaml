<?xml version="1.0" encoding="utf-8" ?>
<ContentPage SafeAreaEdges="All" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="MEIUtil.Views.ClientFormPage" Title="Novo cliente">
<ScrollView><VerticalStackLayout Padding="20" Spacing="16" MaximumWidthRequest="760" HorizontalOptions="Fill">
<VerticalStackLayout Spacing="3"><Label Text="CADASTRO" Style="{StaticResource Eyebrow}"/><Label Text="Novo cliente" Style="{StaticResource TitleLabel}"/><Label Text="Mantenha apenas os dados essenciais para orçamento e contato." Style="{StaticResource Caption}"/></VerticalStackLayout>
<Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="11">
<Label Text="Nome ou razão social" Style="{StaticResource Caption}"/><Entry Text="{Binding Name}" MaxLength="160" ReturnType="Next"/>
<Label Text="CPF ou CNPJ" Style="{StaticResource Caption}"/><Entry Text="{Binding Document}" Keyboard="Text" MaxLength="18" Placeholder="CPF ou CNPJ alfanumérico" ReturnType="Next"/>
<Label Text="Telefone / WhatsApp" Style="{StaticResource Caption}"/><Entry Text="{Binding Phone}" Keyboard="Telephone" MaxLength="40" ReturnType="Next"/>
<Label Text="E-mail" Style="{StaticResource Caption}"/><Entry Text="{Binding Email}" Keyboard="Email" MaxLength="160" ReturnType="Next"/>
<Label Text="Observações" Style="{StaticResource Caption}"/><Editor Text="{Binding Notes}" MinimumHeightRequest="100" MaxLength="220"/>
<Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}"/><ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/><Button Text="Salvar cliente" Command="{Binding SaveCommand}"><Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsSaved}" Value="True"><Setter Property="Text" Value="Salvo"/><Setter Property="IsEnabled" Value="False"/><Setter Property="Opacity" Value="0.72"/></DataTrigger></Button.Triggers></Button>
</VerticalStackLayout></Border></VerticalStackLayout></ScrollView></ContentPage>
