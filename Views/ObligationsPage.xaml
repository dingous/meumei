<?xml version="1.0" encoding="utf-8" ?><ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="MEIUtil.Views.ObligationsPage" x:Name="Page" Title="Obrigações"><Grid Padding="20" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="14" MaximumWidthRequest="1120" HorizontalOptions="Fill"><VerticalStackLayout><Label Text="ORGANIZAÇÃO" Style="{StaticResource Eyebrow}"/><Label Text="Obrigações" Style="{StaticResource TitleLabel}"/></VerticalStackLayout><Border Grid.Row="1" Style="{StaticResource Card}" BackgroundColor="{StaticResource WarningSoft}"><Label Text="Confirme guia, valor e vencimento no portal oficial antes do pagamento." Style="{StaticResource Caption}"/></Border><Label Grid.Row="2" Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}"/><CollectionView Grid.Row="3" ItemsSource="{Binding Items}"><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,9"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding Title}" FontAttributes="Bold"/><Label Text="{Binding Reference, StringFormat='Referência: {0}'}" Style="{StaticResource Caption}"/><Label Text="{Binding DueDate, StringFormat='Lembrete: {0:dd/MM/yyyy}'}" Style="{StaticResource Caption}"/></VerticalStackLayout><Button Grid.Column="1" Text="Alterar" Style="{StaticResource SecondaryButton}" Command="{Binding Source={x:Reference Page}, Path=BindingContext.ToggleDoneCommand}" CommandParameter="{Binding .}"/></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView></Grid></ContentPage>