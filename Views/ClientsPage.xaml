<?xml version="1.0" encoding="utf-8" ?><ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="MEIUtil.Views.ClientsPage" Title="Clientes"><Grid Padding="20" RowDefinitions="Auto,Auto,*" RowSpacing="14" MaximumWidthRequest="1120" HorizontalOptions="Fill"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="RELACIONAMENTO" Style="{StaticResource Eyebrow}"/><Label Text="Clientes" Style="{StaticResource TitleLabel}"/><Label Text="Contatos organizados para o dia a dia do seu negócio." Style="{StaticResource Caption}"/></VerticalStackLayout><ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/></Grid><Grid Grid.Row="1" ColumnDefinitions="*,Auto"><Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}"/><Button Grid.Column="1" Text="+ Novo cliente" Command="{Binding AddCommand}"/></Grid><CollectionView Grid.Row="2" ItemsSource="{Binding Items}"><CollectionView.EmptyView><Label Text="Nenhum cliente cadastrado" HorizontalTextAlignment="Center" FontAttributes="Bold"/></CollectionView.EmptyView><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,9"><VerticalStackLayout><Label Text="{Binding Name}" FontAttributes="Bold"/><Label Text="{Binding Phone}" Style="{StaticResource Caption}"/><Label Text="{Binding Email}" Style="{StaticResource Caption}"/></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView></Grid></ContentPage>