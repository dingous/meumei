<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="MEIUtil.Views.ClientsPage" Title="Clientes">
<Grid Padding="20" RowDefinitions="Auto,Auto,*" RowSpacing="14" MaximumWidthRequest="1120" HorizontalOptions="Fill">
<Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="RELACIONAMENTO" Style="{StaticResource Eyebrow}"/><Label Text="Clientes" Style="{StaticResource TitleLabel}"/><Label Text="Contatos organizados para o dia a dia do seu negócio." Style="{StaticResource Caption}"/></VerticalStackLayout><ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/></Grid>
<FlexLayout Grid.Row="1" Direction="Row" Wrap="Wrap" AlignItems="Center"><Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" FlexLayout.Basis="260" FlexLayout.Grow="1" Margin="0,0,10,8"/><Button Text="+ Novo cliente" Command="{Binding AddCommand}" FlexLayout.Basis="180" FlexLayout.Grow="1"/></FlexLayout>
<CollectionView Grid.Row="2" ItemsSource="{Binding Items}" SelectionMode="None"><CollectionView.EmptyView><VerticalStackLayout Padding="32" Spacing="6"><Label Text="Nenhum cliente cadastrado" HorizontalTextAlignment="Center" FontAttributes="Bold"/><Label Text="Seus clientes aparecerão aqui." Style="{StaticResource Caption}" HorizontalTextAlignment="Center"/></VerticalStackLayout></CollectionView.EmptyView><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,9"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><Border WidthRequest="42" HeightRequest="42" BackgroundColor="{StaticResource PrimarySoft}" StrokeThickness="0" StrokeShape="RoundRectangle 14"><Label Text="{Binding Initials}" TextColor="{StaticResource PrimaryDark}" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></Border><VerticalStackLayout Grid.Column="1" Spacing="2"><Label Text="{Binding Name}" FontAttributes="Bold"/><Label Text="{Binding Phone}" Style="{StaticResource Caption}" IsVisible="{Binding HasPhone}"/><Label Text="{Binding Email}" Style="{StaticResource Caption}" IsVisible="{Binding HasEmail}"/></VerticalStackLayout></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
</Grid></ContentPage>
