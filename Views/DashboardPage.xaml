<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="MEIUtil.Views.DashboardPage" Title="Início">
<ScrollView><VerticalStackLayout Padding="20" Spacing="18" MaximumWidthRequest="1120" HorizontalOptions="Fill">
<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><VerticalStackLayout Spacing="3"><Label Text="VISÃO GERAL" Style="{StaticResource Eyebrow}"/><Label Text="{Binding Greeting}" Style="{StaticResource TitleLabel}"/><Label Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="14"/></VerticalStackLayout><ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center"/></Grid>
<Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}"/>
<Border StrokeThickness="0" Padding="20" StrokeShape="RoundRectangle 22"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#4F46E5" Offset="0"/><GradientStop Color="#7C3AED" Offset="1"/></LinearGradientBrush></Border.Background><Grid ColumnDefinitions="Auto,*" ColumnSpacing="14"><Border WidthRequest="48" HeightRequest="48" BackgroundColor="#26FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 16"><Label Text="★" TextColor="White" FontSize="24" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></Border><VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center"><Label Text="Seu primeiro ano é por nossa conta" TextColor="White" FontSize="17" FontAttributes="Bold"/><Label Text="{Binding TrialText}" TextColor="#E9E7FF" FontSize="12"/></VerticalStackLayout></Grid></Border>
<Label Text="Caixa deste mês" Style="{StaticResource SectionTitle}"/>
<FlexLayout Direction="Row" Wrap="Wrap">
<Border Style="{StaticResource Card}" Margin="0,0,10,10" FlexLayout.Basis="280" FlexLayout.Grow="1"><VerticalStackLayout Spacing="6"><Label Text="RECEBIDAS" Style="{StaticResource Eyebrow}" TextColor="{StaticResource Success}"/><Label Text="{Binding MonthRevenue, StringFormat='{}{0:C2}'}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource Success}"/><Label Text="Receitas já recebidas no mês" Style="{StaticResource Caption}"/></VerticalStackLayout></Border>
<Border Style="{StaticResource Card}" Margin="0,0,0,10" FlexLayout.Basis="280" FlexLayout.Grow="1"><VerticalStackLayout Spacing="6"><Label Text="PAGAS" Style="{StaticResource Eyebrow}" TextColor="{StaticResource Danger}"/><Label Text="{Binding MonthExpenses, StringFormat='{}{0:C2}'}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource Danger}"/><Label Text="Despesas já pagas no mês" Style="{StaticResource Caption}"/></VerticalStackLayout></Border>
<Border Style="{StaticResource Card}" FlexLayout.Basis="100%" FlexLayout.Grow="1"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="SALDO EM CAIXA" Style="{StaticResource Eyebrow}"/><Label Text="{Binding MonthBalance, StringFormat='{}{0:C2}'}" FontSize="30" FontAttributes="Bold"/></VerticalStackLayout><Border Grid.Column="1" Padding="12,7" StrokeThickness="0" BackgroundColor="{StaticResource PrimarySoft}" StrokeShape="RoundRectangle 14" VerticalOptions="Center"><Label Text="Recebido − pago" TextColor="{StaticResource PrimaryDark}" FontSize="11" FontAttributes="Bold"/></Border></Grid></Border>
</FlexLayout>
<Label Text="Limite do MEI" Style="{StaticResource SectionTitle}"/>
<Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="13"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Faturamento registrado no ano" Style="{StaticResource Caption}"/><Label Text="{Binding AnnualRevenue, StringFormat='{}{0:C2}'}" FontSize="26" FontAttributes="Bold"/></VerticalStackLayout><Border Grid.Column="1" Padding="12,7" BackgroundColor="{StaticResource PrimarySoft}" StrokeThickness="0" StrokeShape="RoundRectangle 14"><Label Text="{Binding LimitPercent, StringFormat='{}{0:N1}%'}" TextColor="{StaticResource PrimaryDark}" FontSize="15" FontAttributes="Bold"/></Border></Grid><ProgressBar Progress="{Binding LimitProgress}" ProgressColor="{StaticResource Primary}" HeightRequest="9"/><FlexLayout Direction="Row" Wrap="Wrap"><VerticalStackLayout FlexLayout.Basis="260" FlexLayout.Grow="1" Margin="0,0,8,8"><Label Text="Ainda disponível" Style="{StaticResource Caption}"/><Label Text="{Binding LimitRemaining, StringFormat='{}{0:C2}'}" FontAttributes="Bold"/></VerticalStackLayout><VerticalStackLayout FlexLayout.Basis="260" FlexLayout.Grow="1"><Label Text="Projeção do ano" Style="{StaticResource Caption}"/><Label Text="{Binding AnnualProjection, StringFormat='{}{0:C2}'}" FontAttributes="Bold"/></VerticalStackLayout></FlexLayout><Border Padding="12,8" BackgroundColor="{StaticResource PrimarySoft}" StrokeThickness="0" StrokeShape="RoundRectangle 12"><Label Text="{Binding RiskText}" TextColor="{StaticResource PrimaryDark}" FontAttributes="Bold"/></Border></VerticalStackLayout></Border>
<Label Text="Próxima obrigação" Style="{StaticResource SectionTitle}"/><Border Style="{StaticResource Card}"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="13"><Border WidthRequest="42" HeightRequest="42" BackgroundColor="{StaticResource WarningSoft}" StrokeThickness="0" StrokeShape="RoundRectangle 14"><Label Text="✓" TextColor="{StaticResource Warning}" FontSize="19" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></Border><VerticalStackLayout Grid.Column="1"><Label Text="{Binding NextObligation}" FontAttributes="Bold"/><Label Text="{Binding NextObligationDate}" Style="{StaticResource Caption}"/></VerticalStackLayout></Grid></Border>
<Label Text="Ações rápidas" Style="{StaticResource SectionTitle}"/><FlexLayout Direction="Row" Wrap="Wrap"><Button Text="+ Receita" Command="{Binding NewRevenueCommand}" Margin="0,0,10,10" FlexLayout.Basis="220" FlexLayout.Grow="1"/><Button Text="+ Despesa" Command="{Binding NewExpenseCommand}" Style="{StaticResource DangerButton}" Margin="0,0,10,10" FlexLayout.Basis="220" FlexLayout.Grow="1"/><Button Text="Criar orçamento" Command="{Binding NewQuoteCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,10" FlexLayout.Basis="220" FlexLayout.Grow="1"/></FlexLayout><BoxView HeightRequest="10" Opacity="0"/>
</VerticalStackLayout></ScrollView></ContentPage>
