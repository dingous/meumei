<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="MEIUtil.Views.TransactionFormPage" Title="{Binding PageTitle}">
<ScrollView><VerticalStackLayout Padding="20" Spacing="16" MaximumWidthRequest="760" HorizontalOptions="Fill">
<VerticalStackLayout Spacing="3"><Label Text="LANÇAMENTO" Style="{StaticResource Eyebrow}"/><Label Text="{Binding PageTitle}" Style="{StaticResource TitleLabel}"/><Label Text="Registre o valor e informe se já foi recebido ou pago." Style="{StaticResource Caption}"/></VerticalStackLayout>
<Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="11">
<Label Text="Descrição" Style="{StaticResource Caption}"/><Entry Text="{Binding Description}" MaxLength="180" ReturnType="Next"/>
<Label Text="Categoria" Style="{StaticResource Caption}"/><Picker ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}"/>
<Label Text="Valor" Style="{StaticResource Caption}"/><Entry Text="{Binding Amount}" Keyboard="Numeric" ReturnType="Next"/>
<Label Text="Data" Style="{StaticResource Caption}"/><DatePicker Date="{Binding Date}"/>
<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><CheckBox IsChecked="{Binding IsPaid}"/><Label Grid.Column="1" Text="{Binding PaymentLabel}" VerticalOptions="Center"/></Grid>
<Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}"/><ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/><Button Text="Salvar lançamento" Command="{Binding SaveCommand}"/>
</VerticalStackLayout></Border></VerticalStackLayout></ScrollView></ContentPage>
