<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="MEIUtil.Views.TransactionsPage" x:Name="Page" Title="Receitas e despesas">
<Grid Padding="20" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="14" MaximumWidthRequest="1120" HorizontalOptions="Fill">
<Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="FINANCEIRO" Style="{StaticResource Eyebrow}"/><Label Text="Receitas e despesas" Style="{StaticResource TitleLabel}"/><Label Text="Acompanhe o que já entrou, saiu e o que ainda está pendente." Style="{StaticResource Caption}"/></VerticalStackLayout><ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/></Grid>
<FlexLayout Grid.Row="1" Direction="Row" Wrap="Wrap">
<Border Style="{StaticResource Card}" Margin="0,0,8,8" FlexLayout.Basis="220" FlexLayout.Grow="1"><VerticalStackLayout><Label Text="RECEBIDO" Style="{StaticResource Eyebrow}" TextColor="{StaticResource Success}"/><Label Text="{Binding TotalRevenue, StringFormat='{}{0:C2}'}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Success}"/></VerticalStackLayout></Border>
<Border Style="{StaticResource Card}" Margin="0,0,8,8" FlexLayout.Basis="220" FlexLayout.Grow="1"><VerticalStackLayout><Label Text="PAGO" Style="{StaticResource Eyebrow}" TextColor="{StaticResource Danger}"/><Label Text="{Binding TotalExpenses, StringFormat='{}{0:C2}'}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Danger}"/></VerticalStackLayout></Border>
<Border Style="{StaticResource Card}" FlexLayout.Basis="220" FlexLayout.Grow="1"><VerticalStackLayout><Label Text="SALDO EM CAIXA" Style="{StaticResource Eyebrow}"/><Label Text="{Binding Balance, StringFormat='{}{0:C2}'}" FontSize="20" FontAttributes="Bold"><Label.Triggers><DataTrigger TargetType="Label" Binding="{Binding IsBalanceNegative}" Value="True"><Setter Property="TextColor" Value="{StaticResource Danger}"/></DataTrigger></Label.Triggers></Label></VerticalStackLayout></Border>
</FlexLayout>
<FlexLayout Grid.Row="2" Direction="Row" Wrap="Wrap"><Button Text="+ Receita" Command="{Binding NewRevenueCommand}" Margin="0,0,10,8" FlexLayout.Basis="220" FlexLayout.Grow="1"/><Button Text="+ Despesa" Command="{Binding NewExpenseCommand}" Style="{StaticResource SecondaryButton}" FlexLayout.Basis="220" FlexLayout.Grow="1"/></FlexLayout>
<Grid Grid.Row="3" RowDefinitions="Auto,*"><Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}"/><CollectionView Grid.Row="1" ItemsSource="{Binding Items}" SelectionMode="None">
<CollectionView.EmptyView><VerticalStackLayout Padding="32" Spacing="6"><Label Text="Nenhum lançamento neste mês" FontAttributes="Bold" HorizontalTextAlignment="Center"/><Label Text="Registre uma receita ou despesa para começar." Style="{StaticResource Caption}" HorizontalTextAlignment="Center"/></VerticalStackLayout></CollectionView.EmptyView>
<CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,9"><VerticalStackLayout Spacing="10">
<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><VerticalStackLayout Spacing="2"><Label Text="{Binding Description}" FontAttributes="Bold"/><Label Text="{Binding Category}" Style="{StaticResource Caption}"/></VerticalStackLayout><Label Grid.Column="1" Text="{Binding SignedAmount}" FontAttributes="Bold" VerticalOptions="Start"><Label.Triggers><DataTrigger TargetType="Label" Binding="{Binding Type}" Value="Receita"><Setter Property="TextColor" Value="{StaticResource Success}"/></DataTrigger><DataTrigger TargetType="Label" Binding="{Binding Type}" Value="Despesa"><Setter Property="TextColor" Value="{StaticResource Danger}"/></DataTrigger></Label.Triggers></Label></Grid>
<FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center"><Label Text="{Binding Date, StringFormat='{0:dd/MM/yyyy}'}" Style="{StaticResource Caption}" Margin="0,0,8,4"/><Border Style="{StaticResource Pill}" Margin="0,0,8,4"><Border.Triggers><DataTrigger TargetType="Border" Binding="{Binding IsPaid}" Value="False"><Setter Property="BackgroundColor" Value="{StaticResource WarningSoft}"/></DataTrigger></Border.Triggers><Label Text="{Binding PaymentStatusText}" Style="{StaticResource PillText}"><Label.Triggers><DataTrigger TargetType="Label" Binding="{Binding IsPaid}" Value="False"><Setter Property="TextColor" Value="{StaticResource Warning}"/></DataTrigger></Label.Triggers></Label></Border><Button Text="Excluir" HeightRequest="36" Style="{StaticResource GhostButton}" Command="{Binding Source={x:Reference Page}, Path=BindingContext.DeleteCommand}" CommandParameter="{Binding .}" FlexLayout.Grow="1" HorizontalOptions="End"/></FlexLayout>
</VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView></Grid>
</Grid></ContentPage>
