<?xml version="1.0" encoding="utf-8" ?>
<ContentPage SafeAreaEdges="All" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="MEIUtil.Views.SettingsPage" Title="Meu MEI">
<ScrollView><VerticalStackLayout Padding="20" Spacing="18" MaximumWidthRequest="900" HorizontalOptions="Fill">
<Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="SEU NEGÓCIO" Style="{StaticResource Eyebrow}"/><Label Text="Meu MEI" Style="{StaticResource TitleLabel}"/><Label Text="Dados do negócio, período gratuito e conta Dingous." Style="{StaticResource Caption}"/></VerticalStackLayout><ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/></Grid>
<Border Style="{StaticResource Card}" IsVisible="{Binding IsGoogleLoginAvailable}"><VerticalStackLayout Spacing="14"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><Border WidthRequest="52" HeightRequest="52" StrokeThickness="0" BackgroundColor="{StaticResource PrimarySoft}" StrokeShape="RoundRectangle 18"><Label Text="{Binding AccountInitials}" TextColor="{StaticResource PrimaryDark}" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></Border><VerticalStackLayout Grid.Column="1" VerticalOptions="Center"><Label Text="Conta Dingous" FontAttributes="Bold"/><Label Text="{Binding AccountName}" IsVisible="{Binding IsLoggedIn}" FontAttributes="Bold"/><Label Text="{Binding AccountEmail}" IsVisible="{Binding IsLoggedIn}" Style="{StaticResource Caption}"/><Label Text="Entre com sua conta Google para autenticar no DingousChatTrade." IsVisible="{Binding IsLoggedOut}" Style="{StaticResource Caption}"/></VerticalStackLayout></Grid><Button Text="Continuar com Google" Command="{Binding SignInWithGoogleCommand}" IsVisible="{Binding IsLoggedOut}"/><Button Text="Sair da conta" Command="{Binding SignOutCommand}" IsVisible="{Binding IsLoggedIn}" Style="{StaticResource SecondaryButton}"/><Label Text="Login Google nativo do Android. Sua senha nunca passa pelo Meu MEI." Style="{StaticResource Caption}"/></VerticalStackLayout></Border>
<Border Style="{StaticResource SoftCard}"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><Label Text="★" TextColor="{StaticResource Primary}" FontSize="22"/><VerticalStackLayout Grid.Column="1"><Label Text="{Binding TrialTitle}" FontAttributes="Bold"/><Label Text="{Binding TrialText}" Style="{StaticResource Caption}"/></VerticalStackLayout></Grid></Border>
<Label Text="Dados do MEI" Style="{StaticResource SectionTitle}"/>
<Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="12">
<Label Text="Seu nome" Style="{StaticResource Caption}"/><Entry Text="{Binding Profile.OwnerName}" Placeholder="Nome do responsável" MaxLength="160" ReturnType="Next"/>
<Label Text="Nome do negócio" Style="{StaticResource Caption}"/><Entry Text="{Binding Profile.BusinessName}" Placeholder="Nome fantasia ou razão social" MaxLength="180" ReturnType="Next"/>
<Label Text="CNPJ" Style="{StaticResource Caption}"/><Entry Text="{Binding Profile.Cnpj}" Placeholder="00.000.000/E08G-12" MaxLength="18" Keyboard="Text" ReturnType="Done"/>
<Label Text="Aceita o CNPJ numérico tradicional e o novo formato alfanumérico." Style="{StaticResource Caption}"/>
<FlexLayout Direction="Row" Wrap="Wrap"><VerticalStackLayout FlexLayout.Basis="260" FlexLayout.Grow="1" Margin="0,0,10,8"><Label Text="Data de abertura" Style="{StaticResource Caption}"/><DatePicker Date="{Binding Profile.OpenedAt}"/></VerticalStackLayout><VerticalStackLayout FlexLayout.Basis="260" FlexLayout.Grow="1"><Label Text="Limite anual" Style="{StaticResource Caption}"/><Entry Text="{Binding Profile.AnnualRevenueLimit}" Keyboard="Numeric"/></VerticalStackLayout></FlexLayout>
<Label Text="{Binding Message}" TextColor="{StaticResource Success}"/><Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}"/><Button Text="Salvar dados" Command="{Binding SaveCommand}"/>
</VerticalStackLayout></Border>
<Label Text="Os registros financeiros permanecem neste dispositivo. O login é validado pelo DingousChatTrade e a sessão fica no cofre seguro do sistema." Style="{StaticResource Caption}"/>
</VerticalStackLayout></ScrollView></ContentPage>
