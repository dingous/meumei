<?xml version="1.0" encoding="utf-8" ?>
<ContentPage SafeAreaEdges="All" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="MEIUtil.Views.CalculatorsPage" Title="Calculadoras">
<ScrollView><VerticalStackLayout Padding="20" Spacing="18" MaximumWidthRequest="960" HorizontalOptions="Fill"><VerticalStackLayout Spacing="3"><Label Text="DECISÕES RÁPIDAS" Style="{StaticResource Eyebrow}"/><Label Text="Calculadoras" Style="{StaticResource TitleLabel}"/><Label Text="Ferramentas locais para precificar sem planilha e sem custo por uso." Style="{StaticResource Caption}"/></VerticalStackLayout><Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}"/>
<FlexLayout Direction="Row" Wrap="Wrap"><Border Style="{StaticResource Card}" Margin="0,0,10,10" FlexLayout.Basis="420" FlexLayout.Grow="1"><VerticalStackLayout Spacing="11"><Label Text="Valor da sua hora" Style="{StaticResource SectionTitle}"/><Label Text="Retirada mensal desejada" Style="{StaticResource Caption}"/><Entry Text="{Binding DesiredMonthlyIncome}" Keyboard="Numeric"/><Label Text="Custos mensais do negócio" Style="{StaticResource Caption}"/><Entry Text="{Binding MonthlyBusinessCosts}" Keyboard="Numeric"/><Label Text="Horas faturáveis por mês" Style="{StaticResource Caption}"/><Entry Text="{Binding BillableHours}" Keyboard="Numeric"/><Button Text="Calcular valor/hora" Command="{Binding CalculateHourlyRateCommand}"/><Border Style="{StaticResource SoftCard}"><Label Text="{Binding HourlyRate, StringFormat='{}{0:C2} / hora'}" FontSize="24" FontAttributes="Bold"/></Border></VerticalStackLayout></Border>
<Border Style="{StaticResource Card}" FlexLayout.Basis="420" FlexLayout.Grow="1"><VerticalStackLayout Spacing="11"><Label Text="Preço pela margem" Style="{StaticResource SectionTitle}"/><Label Text="Custo do produto ou serviço" Style="{StaticResource Caption}"/><Entry Text="{Binding ProductCost}" Keyboard="Numeric"/><Label Text="Margem desejada (%)" Style="{StaticResource Caption}"/><Entry Text="{Binding DesiredMarginPercent}" Keyboard="Numeric"/><Button Text="Calcular preço" Command="{Binding CalculateSalePriceCommand}"/><Border Style="{StaticResource SoftCard}"><Label Text="{Binding SuggestedSalePrice, StringFormat='{}{0:C2}'}" FontSize="24" FontAttributes="Bold"/></Border></VerticalStackLayout></Border></FlexLayout>
</VerticalStackLayout></ScrollView></ContentPage>